{%- comment -%}
  Ligne du panier (rendu serveur initial).
  ⚠️ Le même balisage est reproduit en JS dans assets/landing.js (LpCartDrawer.renderItem) : garder les deux synchronisés.

  Accepte :
  - item {Object} : line_item
{%- endcomment -%}
<li class="lp-cart-item" data-key="{{ item.key }}">
  <a href="{{ item.url }}" class="lp-cart-item__media" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', width: 80, height: 80 }}
    {%- endif -%}
  </a>
  <div class="lp-cart-item__info">
    <p class="lp-cart-item__title">{{ item.product.title }}</p>
    {%- unless item.product.has_only_default_variant -%}
      <p class="lp-cart-item__variant">{{ item.variant.title }}</p>
    {%- endunless -%}
    <div class="lp-qty" role="group" aria-label="Quantité">
      <button type="button" class="lp-qty__btn" data-lp-qty="-1" aria-label="Diminuer la quantité">{% render 'lp-icon', icon: 'minus' %}</button>
      <span class="lp-qty__value" aria-live="polite">{{ item.quantity }}</span>
      <button type="button" class="lp-qty__btn" data-lp-qty="1" aria-label="Augmenter la quantité">{% render 'lp-icon', icon: 'plus' %}</button>
    </div>
  </div>
  <div class="lp-cart-item__side">
    <span class="lp-cart-item__price">{{ item.final_line_price | money }}</span>
    {%- if item.original_line_price > item.final_line_price -%}
      <s class="lp-cart-item__compare">{{ item.original_line_price | money }}</s>
    {%- endif -%}
    <button type="button" class="lp-cart-item__remove" data-lp-remove aria-label="Supprimer {{ item.product.title | escape }}">
      {% render 'lp-icon', icon: 'trash' %}
    </button>
  </div>
</li>
