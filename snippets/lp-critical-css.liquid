{%- comment -%}
  CSS critique de la landing produit, injecté inline dans le <head> (layout/landing.liquid).
  Contient uniquement ce qui est visible au premier affichage :
  variables, reset, barre d'annonce, header, section produit, états masqués (tiroirs, barre mobile).
  Le reste est dans assets/landing.css (chargé de façon non bloquante).

  Breakpoints : mobile < 750px · tablette 750–989px · desktop ≥ 990px
{%- endcomment -%}
<style>
  :root {
    /* Couleurs (Réglages du thème > Landing produit) */
    --lp-accent: {{ settings.lp_accent_color | default: '#E5202E' }};
    --lp-accent-rgb: {{ settings.lp_accent_color.rgb | default: '229 32 46' }};
    --lp-accent-text: {{ settings.lp_accent_text_color | default: '#FFFFFF' }};
    --lp-text: {{ settings.lp_text_color | default: '#1A1A1A' }};
    --lp-text-rgb: {{ settings.lp_text_color.rgb | default: '26 26 26' }};
    --lp-muted: {{ settings.lp_muted_color | default: '#6B6B6B' }};
    --lp-bg: {{ settings.lp_background_color | default: '#FFFFFF' }};
    --lp-bg-alt: {{ settings.lp_alt_background_color | default: '#F5F5F7' }};
    --lp-dark: {{ settings.lp_dark_color | default: '#0E0E10' }};
    --lp-border: {{ settings.lp_border_color | default: '#E6E6E9' }};
    --lp-star: {{ settings.lp_star_color | default: '#FFB800' }};
    --lp-success: {{ settings.lp_success_color | default: '#16A34A' }};
    --lp-error: {{ settings.lp_error_color | default: '#D93A3A' }};
    --lp-accent-soft: rgb(var(--lp-accent-rgb) / 0.07);
    --lp-accent-line: rgb(var(--lp-accent-rgb) / 0.28);

    /* Formes & mise en page */
    --lp-radius: {{ settings.lp_radius | default: 14 }}px;
    --lp-radius-sm: calc(var(--lp-radius) * 0.6);
    --lp-btn-radius: {{ settings.lp_button_radius | default: 12 }}px;
    --lp-width: {{ settings.lp_page_width | default: 1200 }}px;
    --lp-gutter: 16px;
    --lp-section-py: 48px;
    --lp-gap: 16px;
    --lp-top-height: 100px;

    /* Typographie : polices du thème Horizon */
    --lp-font-body: var(--font-body--family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    --lp-font-heading: var(--font-heading--family, var(--lp-font-body));
    --lp-heading-weight: 800;
    --lp-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --lp-shadow: 0 10px 30px rgb(0 0 0 / 0.08);
  }

  @media (min-width: 750px) {
    :root { --lp-gutter: 24px; --lp-section-py: 64px; --lp-gap: 20px; }
  }
  @media (min-width: 990px) {
    :root { --lp-gutter: 32px; --lp-section-py: 80px; --lp-gap: 24px; }
  }

  /* ---------- Reset ---------- */
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
  body.lp-body {
    margin: 0;
    background: var(--lp-bg);
    color: var(--lp-text);
    font-family: var(--lp-font-body);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  body.lp-scroll-lock { overflow: hidden; }
  img, video, svg { display: block; max-width: 100%; }
  img, video { height: auto; }
  a { color: inherit; }
  button { font: inherit; color: inherit; cursor: pointer; }
  h1, h2, h3, h4, p { margin: 0; }
  h1, h2, h3, h4 { font-family: var(--lp-font-heading); font-weight: var(--lp-heading-weight); line-height: 1.12; letter-spacing: -0.02em; }
  [hidden] { display: none !important; }
  lp-header, lp-product, lp-video, lp-carousel, lp-accordion { display: block; }
  .lp-visually-hidden { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  .lp-skip-link { position: absolute; left: 8px; top: -60px; z-index: 1000; padding: 10px 16px; background: var(--lp-dark); color: #fff; border-radius: 8px; }
  .lp-skip-link:focus { top: 8px; }
  :focus-visible { outline: 2px solid var(--lp-accent); outline-offset: 2px; }
  .lp-main:focus { outline: none; }

  .lp-container { width: 100%; max-width: calc(var(--lp-width) + var(--lp-gutter) * 2); margin-inline: auto; padding-inline: var(--lp-gutter); }
  .lp-section { padding-block: var(--lp-section-py); scroll-margin-top: var(--lp-top-height); }
  .lp-section--alt { background: var(--lp-bg-alt); }
  .lp-tabular { font-variant-numeric: tabular-nums; }

  /* ---------- Boutons ---------- */
  .lp-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 56px; padding: 14px 24px;
    border: 0; border-radius: var(--lp-btn-radius);
    background: var(--lp-accent); color: var(--lp-accent-text);
    font-family: var(--lp-font-heading); font-size: 17px; font-weight: 800; letter-spacing: 0.01em; line-height: 1.2;
    text-decoration: none; text-align: center;
    box-shadow: 0 8px 22px rgb(var(--lp-accent-rgb) / 0.32);
    transition: transform 0.2s var(--lp-ease), box-shadow 0.2s var(--lp-ease), filter 0.2s;
  }
  .lp-btn:hover { filter: brightness(1.06); transform: translateY(-1px); box-shadow: 0 12px 28px rgb(var(--lp-accent-rgb) / 0.38); }
  .lp-btn:active { transform: translateY(0); }
  .lp-btn[disabled], .lp-btn[aria-disabled='true'] { opacity: 0.55; cursor: not-allowed; transform: none; box-shadow: none; }
  .lp-btn--block { display: flex; width: 100%; }
  .lp-btn.is-loading { pointer-events: none; opacity: 0.8; }

  /* ---------- Étoiles ---------- */
  .lp-stars { --lp-star-size: 16px; position: relative; display: inline-flex; flex: none; width: max-content; max-width: max-content; line-height: 0; }
  .lp-stars__row { display: flex; gap: 2px; }
  .lp-stars__row svg { flex: none; width: var(--lp-star-size); height: var(--lp-star-size); }
  .lp-stars__row--base { color: #D9D9DD; }
  .lp-stars__row--fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; color: var(--lp-star); white-space: nowrap; }

  /* ---------- Barre d'annonce ---------- */
  .lp-top { position: sticky; top: 0; z-index: 70; }
  .lp-announcement { background: var(--lp-dark); color: #fff; font-size: 13px; line-height: 1.3; letter-spacing: 0.04em; }
  .lp-announcement__inner { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 38px; padding: 8px var(--lp-gutter); text-align: center; text-transform: uppercase; font-weight: 600; }
  .lp-announcement__sep { opacity: 0.45; }
  .lp-announcement strong { font-weight: 800; }
  .lp-announcement__timer { display: inline-block; min-width: 8ch; font-weight: 800; font-variant-numeric: tabular-nums; color: #fff; }

  /* ---------- Header ---------- */
  .lp-header { background: var(--lp-bg); border-bottom: 1px solid var(--lp-border); transition: box-shadow 0.25s; }
  .lp-top.is-scrolled .lp-header { box-shadow: 0 6px 20px rgb(0 0 0 / 0.06); }
  .lp-header__inner { display: grid; grid-template-columns: 44px 1fr 44px; align-items: center; gap: 8px; height: 58px; }
  .lp-header__logo { justify-self: center; display: flex; align-items: center; text-decoration: none; font-family: var(--lp-font-heading); font-weight: 800; font-size: 20px; letter-spacing: -0.02em; }
  .lp-header__logo img { width: auto; height: var(--lp-logo-h-mobile, 28px); object-fit: contain; }
  .lp-header__nav { display: none; }
  .lp-icon-btn { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; background: none; border-radius: 50%; }
  .lp-icon-btn svg { width: 24px; height: 24px; }
  .lp-icon-btn:hover { background: rgb(var(--lp-text-rgb) / 0.05); }
  .lp-header__cart { justify-self: end; }
  .lp-cart-count {
    position: absolute; top: 4px; right: 2px; min-width: 18px; height: 18px; padding: 0 5px;
    border-radius: 9px; background: var(--lp-accent); color: var(--lp-accent-text);
    font-size: 11px; font-weight: 800; line-height: 18px; text-align: center; font-variant-numeric: tabular-nums;
  }
  @media (min-width: 990px) {
    .lp-header__inner { grid-template-columns: 1fr auto 1fr; height: 70px; }
    .lp-header__logo { justify-self: start; }
    .lp-header__logo img { height: var(--lp-logo-h, 34px); }
    .lp-header__burger { display: none; }
    .lp-header__nav { display: flex; gap: 36px; }
    .lp-header__nav a { position: relative; padding: 8px 0; font-size: 15px; font-weight: 600; text-decoration: none; }
    .lp-header__nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 2px; background: var(--lp-accent); transform: scaleX(0); transform-origin: left; transition: transform 0.25s var(--lp-ease); }
    .lp-header__nav a:hover::after { transform: scaleX(1); }
  }

  /* ---------- Tiroirs ----------
     Calque fixe plein écran avec overflow: hidden : le tiroir fermé (translaté hors écran)
     ne peut pas élargir le viewport mobile. États fermés ici pour éviter tout flash avant landing.css. */
  .lp-layer { position: fixed; inset: 0; z-index: 200; overflow: hidden; visibility: hidden; pointer-events: none; }
  .lp-layer.is-open { visibility: visible; pointer-events: auto; }
  .lp-overlay { position: absolute; inset: 0; background: rgb(0 0 0 / 0.5); opacity: 0; }
  .lp-drawer { position: absolute; top: 0; bottom: 0; }

  /* ---------- Section produit ---------- */
  .lp-hero { padding-block: 16px 48px; scroll-margin-top: var(--lp-top-height); }
  .lp-hero__grid { display: grid; gap: 24px; }
  @media (min-width: 750px) { .lp-hero { padding-block: 32px 64px; } }
  @media (min-width: 750px) and (max-width: 989px) {
    .lp-gallery, .lp-info { width: 100%; max-width: 620px; margin-inline: auto; }
  }
  @media (min-width: 990px) {
    .lp-hero__grid { grid-template-columns: minmax(0, 55fr) minmax(0, 45fr); gap: 56px; align-items: start; }
    .lp-gallery { position: sticky; top: calc(var(--lp-top-height) + 20px); }
  }

  .lp-gallery { min-width: 0; }
  .lp-gallery__main { position: relative; border-radius: var(--lp-radius); overflow: hidden; background: var(--lp-bg-alt); }
  .lp-gallery__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .lp-gallery__track::-webkit-scrollbar { display: none; }
  .lp-gallery__slide { flex: 0 0 100%; scroll-snap-align: center; aspect-ratio: 1 / 1; }
  .lp-gallery__slide img, .lp-gallery__slide svg { width: 100%; height: 100%; object-fit: cover; }
  .lp-gallery__thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; scrollbar-width: none; padding: 2px; }
  .lp-gallery__thumbs::-webkit-scrollbar { display: none; }
  .lp-gallery__thumb { flex: 0 0 64px; width: 64px; aspect-ratio: 1; padding: 0; border: 2px solid transparent; border-radius: var(--lp-radius-sm); overflow: hidden; background: var(--lp-bg-alt); opacity: 0.7; transition: opacity 0.2s, border-color 0.2s; }
  .lp-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .lp-gallery__thumb[aria-current='true'] { border-color: var(--lp-accent); opacity: 1; }
  @media (min-width: 750px) { .lp-gallery__thumb { flex-basis: 76px; width: 76px; } }

  .lp-info { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .lp-badge {
    align-self: flex-start; display: inline-block;
    padding: 6px 11px; border-radius: 6px; background: var(--lp-accent); color: var(--lp-accent-text);
    font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.2;
  }
  .lp-info__title { font-size: 28px; }
  .lp-info__subtitle { margin-top: -6px; color: var(--lp-muted); font-size: 15px; line-height: 1.45; }
  @media (min-width: 990px) { .lp-info__title { font-size: 36px; } .lp-info__subtitle { font-size: 16px; } }

  .lp-rating { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; color: var(--lp-text); text-decoration: none; }
  .lp-rating:hover .lp-rating__text { text-decoration: underline; }
  .lp-rating__text strong { font-weight: 700; }

  .lp-timer-box {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 11px 14px; border: 1px solid var(--lp-accent-line); border-radius: var(--lp-radius-sm);
    background: var(--lp-accent-soft); font-size: 14px; font-weight: 600;
  }
  .lp-timer-box__label { display: flex; align-items: center; gap: 8px; }
  .lp-timer-box__label svg { width: 18px; height: 18px; color: var(--lp-accent); flex: none; }
  .lp-timer-box__time { font-size: 18px; font-weight: 800; color: var(--lp-accent); font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }

  .lp-price { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .lp-price__compare { color: var(--lp-muted); font-size: 19px; text-decoration: line-through; text-decoration-thickness: 1.5px; }
  .lp-price__current { color: var(--lp-accent); font-family: var(--lp-font-heading); font-size: 36px; font-weight: 900; line-height: 1; letter-spacing: -0.02em; }
  .lp-price__pct { padding: 4px 8px; border-radius: 6px; background: var(--lp-accent); color: var(--lp-accent-text); font-size: 13px; font-weight: 800; }
  .lp-price__note { margin-top: -8px; color: var(--lp-muted); font-size: 13px; }

  .lp-stock { display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .lp-stock strong { color: var(--lp-accent); font-weight: 800; }
  .lp-stock__dot { position: relative; width: 10px; height: 10px; flex: none; border-radius: 50%; background: var(--lp-accent); }
  .lp-stock__dot::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: inherit; animation: lp-ping 1.6s var(--lp-ease) infinite; }
  @keyframes lp-ping { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(2.6); opacity: 0; } }

  .lp-option__label { margin-bottom: 10px; font-size: 14px; }
  .lp-option__label strong { font-weight: 700; }
  .lp-swatches { display: flex; flex-wrap: wrap; gap: 12px; }
  .lp-swatch { position: relative; width: 52px; height: 52px; padding: 0; border: 1px solid var(--lp-border); border-radius: 50%; overflow: hidden; background: var(--lp-swatch, var(--lp-bg-alt)); transition: box-shadow 0.2s; }
  .lp-swatch img { width: 100%; height: 100%; object-fit: cover; }
  .lp-swatch[aria-checked='true'] { box-shadow: 0 0 0 2px var(--lp-bg), 0 0 0 4px var(--lp-accent); }
  .lp-swatch.is-unavailable::after { content: ''; position: absolute; top: 50%; left: -10%; width: 120%; height: 1.5px; background: var(--lp-muted); transform: rotate(-45deg); }

  .lp-packs { display: grid; gap: 12px; }
  .lp-pack {
    position: relative; display: grid; grid-template-columns: 22px 56px minmax(0, 1fr) auto; align-items: center; gap: 12px;
    width: 100%; padding: 14px; border: 1.5px solid var(--lp-border); border-radius: var(--lp-radius);
    background: var(--lp-bg); text-align: left; transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .lp-pack:hover { border-color: rgb(var(--lp-text-rgb) / 0.35); }
  .lp-pack[aria-checked='true'] { border-color: var(--lp-accent); background: var(--lp-accent-soft); box-shadow: 0 0 0 1px var(--lp-accent); }
  .lp-pack__radio { width: 22px; height: 22px; border: 2px solid rgb(var(--lp-text-rgb) / 0.3); border-radius: 50%; transition: border 0.2s; }
  .lp-pack[aria-checked='true'] .lp-pack__radio { border: 7px solid var(--lp-accent); }
  .lp-pack__media { width: 56px; height: 56px; border-radius: var(--lp-radius-sm); overflow: hidden; background: var(--lp-bg-alt); }
  .lp-pack__media img { width: 100%; height: 100%; object-fit: cover; }
  .lp-pack__title { display: block; font-size: 15px; font-weight: 800; line-height: 1.25; }
  .lp-pack__desc { display: block; margin-top: 3px; color: var(--lp-muted); font-size: 13px; line-height: 1.35; }
  .lp-pack__prices { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; white-space: nowrap; }
  .lp-pack__price { font-size: 17px; font-weight: 900; color: var(--lp-accent); }
  .lp-pack__compare { font-size: 13px; color: var(--lp-muted); text-decoration: line-through; }
  .lp-pack__badge { position: absolute; top: -10px; right: 14px; padding: 3px 10px; border-radius: 999px; background: var(--lp-dark); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  .lp-pack__badge--accent { background: var(--lp-accent); color: var(--lp-accent-text); }
  @media (max-width: 420px) { .lp-pack { grid-template-columns: 20px 48px minmax(0, 1fr) auto; gap: 10px; padding: 12px; } .lp-pack__media { width: 48px; height: 48px; } }

  .lp-atc__error { margin-top: 8px; color: var(--lp-error); font-size: 14px; }
  .lp-payments { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .lp-payments svg { width: 38px; height: 24px; }
  .lp-payments img { max-height: 28px; width: auto; margin-inline: auto; }

  .lp-assurances { display: grid; gap: 10px; margin: 4px 0 0; padding: 0; list-style: none; }
  .lp-assurance { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: var(--lp-radius-sm); background: var(--lp-bg-alt); }
  .lp-assurance__icon { display: grid; place-items: center; width: 38px; height: 38px; flex: none; border-radius: 50%; background: var(--lp-bg); color: var(--lp-accent); }
  .lp-assurance__icon svg { width: 20px; height: 20px; }
  .lp-assurance__title { display: block; font-size: 14px; font-weight: 700; line-height: 1.25; }
  .lp-assurance__text { display: block; color: var(--lp-muted); font-size: 13px; line-height: 1.3; }
  @media (min-width: 750px) {
    .lp-assurances { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lp-assurance { flex-direction: column; text-align: center; gap: 8px; padding: 14px 8px; }
  }

  /* ---------- Barre CTA mobile ---------- */
  .lp-sticky-atc { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; transform: translateY(110%); }
  @media (min-width: 750px) { .lp-sticky-atc { display: none !important; } }
</style>
