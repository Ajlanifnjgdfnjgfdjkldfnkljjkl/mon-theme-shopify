{%- comment -%}
  Carte d'avis client.

  Accepte :
  - name {String} · rating {Number} · text {String}
  - city {String} · pack {String} · color {String}
  - verified {Boolean} : affiche « ✓ Achat vérifié » (uniquement pour un achat réel)
  - verified_label {String}
  - index {Number} : sert à varier la couleur de l'avatar
  - attributes {String} : attributs éditeur (block.shopify_attributes)
{%- endcomment -%}
{%- liquid
  assign lp_initial = name | strip | slice: 0 | upcase | default: '?'
  assign lp_palette = '#E5202E,#2F6FE4,#16A34A,#7C5CD6,#F08A24,#0EA5A4' | split: ','
  assign lp_color_index = index | default: 0 | modulo: lp_palette.size
  assign lp_meta = ''
  if city != blank
    assign lp_meta = lp_meta | append: city
  endif
  if pack != blank
    if lp_meta != blank
      assign lp_meta = lp_meta | append: ' · '
    endif
    assign lp_meta = lp_meta | append: pack
  endif
  if color != blank
    if lp_meta != blank
      assign lp_meta = lp_meta | append: ' · '
    endif
    assign lp_meta = lp_meta | append: color
  endif
-%}
<article class="lp-review" {{ attributes }}>
  {% render 'lp-stars', rating: rating, size: 16 %}
  <div class="lp-review__text">{{ text }}</div>
  <footer class="lp-review__author">
    <span class="lp-review__avatar" style="--lp-avatar: {{ lp_palette[lp_color_index] }};" aria-hidden="true">{{ lp_initial }}</span>
    <span class="lp-review__who">
      <span class="lp-review__name">
        {{ name }}
        {%- if verified -%}
          <span class="lp-review__verified">{% render 'lp-icon', icon: 'check' %} {{ verified_label | default: 'Achat vérifié' }}</span>
        {%- endif -%}
      </span>
      {%- if lp_meta != blank -%}
        <span class="lp-review__meta">{{ lp_meta }}</span>
      {%- endif -%}
    </span>
  </footer>
</article>
