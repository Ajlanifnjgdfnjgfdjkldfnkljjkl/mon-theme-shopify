{%- comment -%}
  Landing — Témoignages vidéo (carrousel)
  Vidéos verticales (9:16) en lecture auto muette, chargées au scroll.
  Mobile : défilement horizontal avec scroll-snap · Desktop : 4 vidéos visibles + flèches.
{%- endcomment -%}
{%- liquid
  assign heading_id = 'LpTestimonialsHeading-' | append: section.id
  # Hors éditeur, on n'affiche que les témoignages qui ont une vidéo (ou au moins une affiche).
  assign filled_count = 0
  for block in section.blocks
    if block.settings.video != blank or block.settings.video_url != blank or block.settings.poster != blank
      assign filled_count = filled_count | plus: 1
    endif
  endfor
  assign show_section = true
  if filled_count == 0 and request.design_mode == false
    assign show_section = false
  endif
-%}
{%- if show_section -%}
<section
  class="lp-section lp-testimonials{% if section.settings.background == 'alt' %} lp-section--alt{% endif %}"
  {% if section.settings.heading != blank %}aria-labelledby="{{ heading_id }}"{% else %}aria-label="Témoignages vidéo"{% endif %}
>
  <div class="lp-container">
    {% render 'lp-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      id: heading_id
    %}

    <lp-carousel class="lp-carousel">
      <div class="lp-carousel__track" data-lp-carousel-track tabindex="0" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_media = false
            if block.settings.video != blank or block.settings.video_url != blank or block.settings.poster != blank
              assign has_media = true
            endif
            if has_media == false and request.design_mode == false
              continue
            endif
          -%}
          <article class="lp-testimonial" role="listitem" {{ block.shopify_attributes }}>
            {% render 'lp-video',
              video: block.settings.video,
              url: block.settings.video_url,
              poster: block.settings.poster,
              max_height: 720,
              poster_width: 600,
              class: 'lp-testimonial__video',
              label: block.settings.name
            %}
            <div class="lp-testimonial__overlay">
              {%- if block.settings.name != blank -%}
                <span class="lp-testimonial__name">{{ block.settings.name }}</span>
              {%- endif -%}
              {%- if block.settings.verified -%}
                <span class="lp-testimonial__verified">
                  {% render 'lp-icon', icon: 'check' %}
                  {{ section.settings.verified_label }}
                </span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if filled_count > 1 or request.design_mode and section.blocks.size > 1 -%}
        <div class="lp-carousel__nav">
          <button type="button" class="lp-carousel__arrow" data-lp-carousel-prev aria-label="Vidéo précédente">
            {% render 'lp-icon', icon: 'chevron-left' %}
          </button>
          <button type="button" class="lp-carousel__arrow" data-lp-carousel-next aria-label="Vidéo suivante">
            {% render 'lp-icon', icon: 'chevron-right' %}
          </button>
        </div>
      {%- endif -%}
    </lp-carousel>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Témoignages vidéo",
  "tag": "div",
  "class": "lp-section-testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre (optionnel)" },
    { "type": "text", "id": "heading", "label": "Titre (optionnel)" },
    { "type": "text", "id": "verified_label", "label": "Libellé « achat vérifié »", "default": "Achat vérifié" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Principal" },
        { "value": "alt", "label": "Alterné (gris clair)" }
      ],
      "default": "alt"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage",
      "settings": [
        { "type": "video", "id": "video", "label": "Vidéo (hébergée sur Shopify)" },
        { "type": "text", "id": "video_url", "label": "…ou URL MP4 (CDN Shopify)" },
        { "type": "image_picker", "id": "poster", "label": "Image d'affiche (optionnel)" },
        { "type": "text", "id": "name", "label": "Nom du client", "default": "Prénom N." },
        { "type": "checkbox", "id": "verified", "label": "Afficher « Achat vérifié »", "default": false, "info": "À n'activer que si ce client a réellement acheté le produit." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Témoignages vidéo",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
