{%- comment -%}
  Landing — Barre d'annonce
  « DÉSTOCKAGE DE RENTRÉE | Fin dans : HH:MM:SS »
  Rendue dans le conteneur sticky .lp-top (layout/landing.liquid) : toujours visible.
{%- endcomment -%}
<div class="lp-announcement" role="region" aria-label="Annonce">
  <div class="lp-announcement__inner">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="lp-announcement__text" style="text-decoration: none;">{{ section.settings.text }}</a>
    {%- else -%}
      <span class="lp-announcement__text">{{ section.settings.text }}</span>
    {%- endif -%}

    {%- if section.settings.show_timer -%}
      <span class="lp-announcement__sep" aria-hidden="true">|</span>
      <span>
        <strong>{{ section.settings.timer_label }}</strong>
        {{ section.settings.timer_separator }}
        {% render 'lp-countdown',
          mode: section.settings.countdown_mode,
          end_date: section.settings.countdown_end,
          class: 'lp-announcement__timer'
        %}
      </span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Landing — Annonce",
  "tag": "div",
  "class": "lp-section-announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "text", "label": "Texte", "default": "DÉSTOCKAGE DE RENTRÉE" },
    { "type": "url", "id": "link", "label": "Lien (optionnel)" },
    { "type": "header", "content": "Compte à rebours" },
    { "type": "checkbox", "id": "show_timer", "label": "Afficher le compte à rebours", "default": true },
    { "type": "text", "id": "timer_label", "label": "Libellé (en gras)", "default": "Fin dans" },
    { "type": "text", "id": "timer_separator", "label": "Séparateur", "default": ":" },
    {
      "type": "select",
      "id": "countdown_mode",
      "label": "Fin du compte à rebours",
      "options": [
        { "value": "midnight", "label": "Chaque jour à minuit (heure du visiteur)" },
        { "value": "date", "label": "Date de fin fixe" }
      ],
      "default": "midnight"
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Date de fin (si date fixe)",
      "info": "Format ISO : 2026-10-31T23:59:59+01:00",
      "visible_if": "{{ section.settings.countdown_mode == 'date' }}"
    }
  ],
  "presets": [{ "name": "Landing — Annonce" }]
}
{% endschema %}
