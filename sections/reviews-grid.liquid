{%- comment -%}
  Landing — Avis « 860 joueurs l'ont adoptée »
  Note globale (gros chiffre + étoiles) + grille d'avis (3 col. desktop · 2 tablette · 1 mobile).

  Avis : metafield JSON custom.reviews_data, sinon blocs « Avis » de la section.
  Format du metafield (tableau) :
  [
    { "name": "Prénom N.", "rating": 5, "text": "…", "city": "Lyon", "pack": "Pack Complet", "color": "Noir", "verified": true }
  ]
  Seuls de vrais avis clients doivent être publiés ; « verified » ne doit être vrai que pour un achat réel.
  Note & nombre d'avis : snippets/lp-review-value.liquid ([note], [avis]).
{%- endcomment -%}
{%- liquid
  capture review_score
    render 'lp-review-value', product: product, part: 'score'
  endcapture
  capture review_score_raw
    render 'lp-review-value', product: product, part: 'score_raw'
  endcapture
  capture review_count
    render 'lp-review-value', product: product, part: 'count'
  endcapture
  assign review_score = review_score | strip
  assign review_count = review_count | strip

  assign reviews = product.metafields.custom.reviews_data.value
  assign use_metafield = false
  if reviews.size > 0
    assign use_metafield = true
  endif

  assign heading = section.settings.heading
  if review_count == blank
    assign heading = section.settings.heading_fallback
  endif
  assign heading = heading | replace: '[avis]', review_count | replace: '[note]', review_score
  assign heading_id = 'LpReviewsHeading-' | append: section.id
-%}
<section
  class="lp-section lp-reviews{% if section.settings.background == 'alt' %} lp-section--alt{% endif %}"
  id="{{ section.settings.anchor | default: 'avis' }}"
  aria-labelledby="{{ heading_id }}"
>
  <div class="lp-container">
    {% render 'lp-section-heading', eyebrow: section.settings.eyebrow, heading: heading, id: heading_id %}

    {%- if review_score != blank -%}
      <div class="lp-reviews__summary">
        <span class="lp-reviews__score">{{ review_score }}</span>
        <span class="lp-reviews__summary-side">
          {% render 'lp-stars', rating: review_score_raw, size: 22 %}
          {%- if review_count != blank -%}
            <span class="lp-reviews__summary-text">{{ section.settings.summary_text | replace: '[avis]', review_count }}</span>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}

    <div class="lp-reviews__grid">
      {%- if use_metafield -%}
        {%- for review in reviews limit: section.settings.limit -%}
          {% render 'lp-review-card',
            name: review.name,
            rating: review.rating,
            text: review.text,
            city: review.city,
            pack: review.pack,
            color: review.color,
            verified: review.verified,
            verified_label: section.settings.verified_label,
            index: forloop.index0
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks limit: section.settings.limit -%}
          {% render 'lp-review-card',
            name: block.settings.name,
            rating: block.settings.rating,
            text: block.settings.text,
            city: block.settings.city,
            pack: block.settings.pack,
            color: block.settings.color,
            verified: block.settings.verified,
            verified_label: section.settings.verified_label,
            index: forloop.index0,
            attributes: block.shopify_attributes
          %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if request.design_mode and use_metafield == false and section.blocks.size == 0 -%}
      <p class="lp-editor-note">
        Aucun avis à afficher. Ajoutez vos avis clients réels dans le metafield JSON « custom.reviews_data »
        du produit ou via des blocs « Avis » (voir LANDING-PAGE.md).
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Landing — Avis clients",
  "tag": "div",
  "class": "lp-section-reviews",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (sans #)", "default": "avis" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Retours clients" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "[avis] joueurs l'ont adoptée", "info": "[avis] = nombre d'avis, [note] = note moyenne." },
    { "type": "text", "id": "heading_fallback", "label": "Titre si aucun nombre d'avis", "default": "Ils l'ont adoptée" },
    { "type": "text", "id": "summary_text", "label": "Texte sous la note", "default": "Note moyenne sur [avis] commandes" },
    { "type": "text", "id": "verified_label", "label": "Libellé « achat vérifié »", "default": "Achat vérifié" },
    { "type": "range", "id": "limit", "label": "Nombre d'avis max.", "min": 1, "max": 24, "step": 1, "default": 6 },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Principal" },
        { "value": "alt", "label": "Alterné (gris clair)" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "paragraph", "content": "Publiez uniquement de vrais avis clients." },
        { "type": "text", "id": "name", "label": "Nom (ex. Prénom N.)" },
        { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Texte de l'avis" },
        { "type": "text", "id": "city", "label": "Ville" },
        { "type": "text", "id": "pack", "label": "Pack acheté" },
        { "type": "text", "id": "color", "label": "Coloris" },
        { "type": "checkbox", "id": "verified", "label": "Achat vérifié", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Landing — Avis clients" }]
}
{% endschema %}
