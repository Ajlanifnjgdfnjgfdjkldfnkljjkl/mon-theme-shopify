{%- comment -%}
  Landing — Specs « Ce qui la rend unique »
  Grille bento asymétrique d'images (les images parlent d'elles-mêmes).
  Desktop (4 colonnes × 2 rangées) : grande image 2×2, image large 2×1, deux images 1×1.
  Mobile : 2 colonnes, la grande image et l'image large occupent toute la largeur.
{%- endcomment -%}
{%- liquid
  assign heading_id = 'LpSpecsHeading-' | append: section.id
  assign image_count = 0
  for block in section.blocks
    if block.settings.image != blank
      assign image_count = image_count | plus: 1
    endif
  endfor
-%}
{%- if image_count > 0 or request.design_mode -%}
<section
  class="lp-section lp-specs{% if section.settings.background == 'alt' %} lp-section--alt{% endif %}"
  aria-labelledby="{{ heading_id }}"
>
  <div class="lp-container">
    {% render 'lp-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      id: heading_id
    %}

    <div class="lp-bento">
      {%- for block in section.blocks -%}
        {%- liquid
          if block.settings.image == blank and request.design_mode == false
            continue
          endif
          case block.settings.size
            when 'large'
              assign sizes = '(min-width: 990px) 600px, 100vw'
            when 'wide'
              assign sizes = '(min-width: 990px) 600px, 100vw'
            else
              assign sizes = '(min-width: 990px) 300px, 50vw'
          endcase
          assign img_alt = block.settings.alt | default: block.settings.image.alt
        -%}
        <figure class="lp-bento__item lp-bento__item--{{ block.settings.size }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag:
              alt: img_alt,
              loading: 'lazy',
              widths: '360, 540, 720, 960, 1200, 1400',
              sizes: sizes
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'lp-placeholder' }}
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Landing — Specs (bento)",
  "tag": "div",
  "class": "lp-section-specs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Sous le capot" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce qui la rend unique" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Principal" },
        { "value": "alt", "label": "Alterné (gris clair)" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Format conseillé : .webp" },
        { "type": "text", "id": "alt", "label": "Texte alternatif" },
        {
          "type": "select",
          "id": "size",
          "label": "Taille dans la grille",
          "options": [
            { "value": "large", "label": "Grande (2×2)" },
            { "value": "wide", "label": "Large (2×1)" },
            { "value": "tall", "label": "Haute (1×2)" },
            { "value": "small", "label": "Standard (1×1)" }
          ],
          "default": "small"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing — Specs (bento)",
      "blocks": [
        { "type": "image", "settings": { "size": "large", "alt": "Écran supérieur AMOLED" } },
        { "type": "image", "settings": { "size": "wide", "alt": "Processeur Qualcomm Snapdragon 8 Gen 2" } },
        { "type": "image", "settings": { "size": "small", "alt": "Benchmark" } },
        { "type": "image", "settings": { "size": "small", "alt": "Console en main" } }
      ]
    }
  ]
}
{% endschema %}
