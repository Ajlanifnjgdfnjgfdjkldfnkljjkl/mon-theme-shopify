{%- comment -%}
  Landing — CTA finale « Dernière chance. Stock en voie d'épuisement. »
  H2 + sous-texte + bouton (ancre vers la section produit) + 4 mini badges.
  Jetons : [prix] = prix minimum du produit · [note] / [avis] = données d'avis.
{%- endcomment -%}
{%- liquid
  capture review_score
    render 'lp-review-value', product: product, part: 'score'
  endcapture
  capture review_count
    render 'lp-review-value', product: product, part: 'count'
  endcapture
  assign review_score = review_score | strip
  assign review_count = review_count | strip
  assign price_min = product.price_min | money
  assign heading_id = 'LpBottomCtaHeading-' | append: section.id
-%}
<section class="lp-section lp-bottom-cta lp-bottom-cta--{{ section.settings.style }}" aria-labelledby="{{ heading_id }}">
  <div class="lp-container lp-bottom-cta__inner">
    <h2 class="lp-h2" id="{{ heading_id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="lp-bottom-cta__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#produit' }}" class="lp-btn lp-bottom-cta__button">
        {{- section.settings.button_label | replace: '[prix]', price_min -}}
      </a>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="lp-bottom-cta__badges" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign badge_text = block.settings.text | replace: '[prix]', price_min | replace: '[note]', review_score | replace: '[avis]', review_count
            assign badge_needs_reviews = false
            if block.settings.text contains '[note]' or block.settings.text contains '[avis]'
              assign badge_needs_reviews = true
            endif
          -%}
          {%- unless badge_needs_reviews and review_score == blank -%}
            <li class="lp-bottom-cta__badge" {{ block.shopify_attributes }}>
              {% render 'lp-icon', icon: block.settings.icon %}
              <span>{{ badge_text }}</span>
            </li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Landing — CTA finale",
  "tag": "div",
  "class": "lp-section-bottom-cta",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Dernière chance. Stock en voie d'épuisement." },
    { "type": "text", "id": "text", "label": "Sous-texte", "default": "Livraison offerte · 30 jours satisfait ou remboursé · Paiement sécurisé" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Profiter du destockage — à partir de [prix]", "info": "[prix] = prix le plus bas du produit." },
    { "type": "text", "id": "button_link", "label": "Lien du bouton", "default": "#produit" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "dark", "label": "Sombre" },
        { "value": "alt", "label": "Gris clair" },
        { "value": "light", "label": "Clair" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Mini badge",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "truck", "label": "Camion" },
            { "value": "return", "label": "Retour" },
            { "value": "lock", "label": "Cadenas" },
            { "value": "star", "label": "Étoile" },
            { "value": "shield", "label": "Bouclier" },
            { "value": "package", "label": "Colis" },
            { "value": "gift", "label": "Cadeau" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Texte", "default": "Reçu en 3–5 jours", "info": "Jetons : [note], [avis], [prix]" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing — CTA finale",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "text": "Reçu en 3–5 jours" } },
        { "type": "badge", "settings": { "icon": "return", "text": "Retour gratuit 30J" } },
        { "type": "badge", "settings": { "icon": "lock", "text": "Paiement sécurisé" } },
        { "type": "badge", "settings": { "icon": "star", "text": "[note]/5 · [avis] avis" } }
      ]
    }
  ]
}
{% endschema %}
