{%- comment -%}
  Landing — Section produit principale (hero)

  Colonne gauche : galerie (image principale + vignettes), filtrée selon le coloris actif.
  Colonne droite : badge, titre, sous-titre, note, compte à rebours, prix, stock, coloris,
  packs, CTA, moyens de paiement, réassurance. + barre CTA sticky mobile.

  Données (produit Shopify en priorité, metafields en repli) :
  - Prix / prix barré / % de remise : variante sélectionnée (price / compare_at_price)
  - Badge : metafield custom.badge_text, sinon « préfixe + −XX % » calculé
  - Sous-titre : metafield custom.subtitle, sinon réglage de la section
  - Stock : inventaire Shopify si suivi, sinon metafield custom.urgency_stock
  - Note / nb d'avis : snippets/lp-review-value.liquid

  Variantes attendues : option « Coloris » (Noir, Blanc…) × option « Pack » (Console seule, Pack Protection…).
  Images par coloris : texte alternatif de l'image commençant par le nom du coloris (ex. « Noir », « Noir - face »)
  ou image mise en avant de la variante. Les images sans coloris sont affichées pour tous les coloris.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  # ---- Détection des options Coloris / Pack (noms configurables) ----
  assign color_names = section.settings.color_option_names | downcase | split: ','
  assign pack_names = section.settings.pack_option_names | downcase | split: ','
  assign color_option = nil
  assign pack_option = nil
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    for name in color_names
      assign clean_name = name | strip
      if option_name == clean_name
        assign color_option = option
      endif
    endfor
    for name in pack_names
      assign clean_name = name | strip
      if option_name == clean_name
        assign pack_option = option
      endif
    endfor
  endfor

  assign color_key = ''
  assign active_color = ''
  if color_option
    assign color_key = 'option' | append: color_option.position
    assign active_color = color_option.selected_value | handleize
  endif
  assign pack_key = ''
  if pack_option
    assign pack_key = 'option' | append: pack_option.position
  endif

  # ---- Association média → coloris (handle du coloris, ou "_" = commun) ----
  assign media_colors = ''
  assign active_color_media_count = 0
  for media in product.media
    assign media_color = '_'
    if color_option
      assign alt_handle = media.alt | handleize
      for value in color_option.values
        assign value_handle = value.name | handleize
        assign value_size = value_handle.size
        assign alt_prefix = alt_handle | slice: 0, value_size
        assign alt_next = alt_handle | slice: value_size, 1
        if alt_prefix == value_handle
          if alt_next == blank or alt_next == '-'
            assign media_color = value_handle
            break
          endif
        endif
      endfor
      if media_color == '_'
        for variant in product.variants
          if variant.featured_media.id == media.id
            assign media_color = variant[color_key] | handleize
            break
          endif
        endfor
      endif
    endif
    if media_color == active_color
      assign active_color_media_count = active_color_media_count | plus: 1
    endif
    assign media_colors = media_colors | append: media_color | append: '|'
  endfor
  assign media_colors = media_colors | split: '|'
  assign filter_gallery = false
  if color_option and active_color_media_count > 0
    assign filter_gallery = true
  endif

  # ---- Badge, remise, sous-titre ----
  assign discount_pct = 0
  if current_variant.compare_at_price > current_variant.price
    assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
  assign subtitle = product.metafields.custom.subtitle.value | default: section.settings.subtitle

  # ---- Avis ----
  capture review_score
    render 'lp-review-value', product: product, part: 'score'
  endcapture
  capture review_score_raw
    render 'lp-review-value', product: product, part: 'score_raw'
  endcapture
  capture review_count
    render 'lp-review-value', product: product, part: 'count'
  endcapture
  assign review_score = review_score | strip
  assign review_count = review_count | strip

  # ---- Stock ----
  assign stock_value = nil
  if current_variant.inventory_management == 'shopify'
    if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.stock_threshold
      assign stock_value = current_variant.inventory_quantity
    endif
  else
    assign stock_value = product.metafields.custom.urgency_stock.value
  endif

  assign first_image_done = false
-%}

<lp-product
  class="lp-hero"
  id="{{ section.settings.anchor | default: 'produit' }}"
  data-section-id="{{ section.id }}"
  data-stock-threshold="{{ section.settings.stock_threshold }}"
  data-filter-gallery="{{ filter_gallery }}"
>
  <script type="application/json" data-lp-product-json>
    {
      "colorIndex": {% if color_option %}{{ color_option.position | minus: 1 }}{% else %}-1{% endif %},
      "packIndex": {% if pack_option %}{{ pack_option.position | minus: 1 }}{% else %}-1{% endif %},
      "metafieldStock": {% if product.metafields.custom.urgency_stock.value != blank %}{{ product.metafields.custom.urgency_stock.value | json }}{% else %}null{% endif %},
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price }},
            "compare": {{ variant.compare_at_price | default: 0 }},
            "available": {{ variant.available }},
            "inventory": {% if variant.inventory_management == 'shopify' %}{{ variant.inventory_quantity }}{% else %}null{% endif %},
            "media": {{ variant.featured_media.id | default: 'null' }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

  <div class="lp-container lp-hero__grid">
    {%- comment -%} ===================== Galerie ===================== {%- endcomment -%}
    <div class="lp-gallery" data-lp-gallery>
      <div class="lp-gallery__main">
        <div class="lp-gallery__track" data-lp-gallery-track aria-label="Galerie d'images" tabindex="0">
          {%- for media in product.media -%}
            {%- liquid
              assign media_color = media_colors[forloop.index0] | default: '_'
              assign media_alt = media.alt | default: product.title
              assign is_hidden = false
              if filter_gallery and media_color != '_' and media_color != active_color
                assign is_hidden = true
              endif
            -%}
            <div
              class="lp-gallery__slide"
              data-lp-slide
              data-media-id="{{ media.id }}"
              data-color="{{ media_color }}"
              {% if is_hidden %}hidden{% endif %}
            >
              {%- if is_hidden == false and first_image_done == false -%}
                {%- assign first_image_done = true -%}
                {{ media.preview_image | image_url: width: 1400 | image_tag:
                  alt: media_alt,
                  loading: 'eager',
                  fetchpriority: 'high',
                  preload: true,
                  widths: '480, 720, 960, 1200, 1400',
                  sizes: '(min-width: 1290px) 660px, (min-width: 990px) 52vw, calc(100vw - 32px)'
                }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1400 | image_tag:
                  alt: media_alt,
                  loading: 'lazy',
                  widths: '480, 720, 960, 1200, 1400',
                  sizes: '(min-width: 1290px) 660px, (min-width: 990px) 52vw, calc(100vw - 32px)'
                }}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="lp-gallery__slide" data-lp-slide data-color="_">
              {{ 'product-1' | placeholder_svg_tag: 'lp-placeholder' }}
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if product.media.size > 1 -%}
        <div class="lp-gallery__thumbs" data-lp-gallery-thumbs>
          {%- assign first_thumb_done = false -%}
          {%- for media in product.media -%}
            {%- liquid
              assign media_color = media_colors[forloop.index0] | default: '_'
              assign is_hidden = false
              if filter_gallery and media_color != '_' and media_color != active_color
                assign is_hidden = true
              endif
              assign is_current = false
              if is_hidden == false and first_thumb_done == false
                assign is_current = true
                assign first_thumb_done = true
              endif
            -%}
            <button
              type="button"
              class="lp-gallery__thumb"
              data-lp-thumb
              data-media-id="{{ media.id }}"
              data-color="{{ media_color }}"
              aria-label="Afficher l'image {{ forloop.index }}"
              aria-current="{{ is_current }}"
              {% if is_hidden %}hidden{% endif %}
            >
              {{ media.preview_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', widths: '80, 160', sizes: '76px' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ===================== Informations ===================== {%- endcomment -%}
    <div class="lp-info">
      {%- comment -%} 1. Badge {%- endcomment -%}
      {%- if product.metafields.custom.badge_text != blank -%}
        <span class="lp-badge">{{ product.metafields.custom.badge_text.value }}</span>
      {%- elsif section.settings.badge_prefix != blank and discount_pct > 0 -%}
        <span class="lp-badge" data-lp-discount-badge>
          {{- section.settings.badge_prefix }} −<span data-lp-discount>{{ discount_pct }}</span>%
        </span>
      {%- endif -%}

      {%- comment -%} 2-3. Titre + sous-titre {%- endcomment -%}
      <div>
        <h1 class="lp-info__title">{{ product.title }}</h1>
      </div>
      {%- if subtitle != blank -%}
        <p class="lp-info__subtitle">{{ subtitle }}</p>
      {%- endif -%}

      {%- comment -%} 4. Note {%- endcomment -%}
      {%- if review_score != blank and review_count != blank -%}
        <a class="lp-rating" href="#{{ section.settings.reviews_anchor | default: 'avis' }}">
          {% render 'lp-stars', rating: review_score_raw, size: 17, label: false %}
          <span class="lp-rating__text">
            {{- section.settings.rating_text
              | replace: '[note]', review_score
              | replace: '[avis]', review_count
            -}}
          </span>
        </a>
      {%- endif -%}

      {%- comment -%} 5. Compte à rebours {%- endcomment -%}
      {%- if section.settings.show_countdown -%}
        <div class="lp-timer-box">
          <span class="lp-timer-box__label">
            {% render 'lp-icon', icon: 'clock' %}
            {{ section.settings.countdown_label }}
          </span>
          {% render 'lp-countdown',
            mode: section.settings.countdown_mode,
            end_date: section.settings.countdown_end,
            class: 'lp-timer-box__time'
          %}
        </div>
      {%- endif -%}

      {%- comment -%} 6-7. Prix {%- endcomment -%}
      <div class="lp-price" data-lp-price-block>
        <s class="lp-price__compare" data-lp-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
          <span class="lp-visually-hidden">Prix normal</span>
          <span data-lp-compare-value>{{ current_variant.compare_at_price | money }}</span>
        </s>
        <span class="lp-price__current">
          <span class="lp-visually-hidden">Prix réduit</span>
          <span data-lp-price>{{ current_variant.price | money }}</span>
        </span>
        <span class="lp-price__pct" data-lp-pct {% unless discount_pct > 0 %}hidden{% endunless %}>
          −<span data-lp-discount>{{ discount_pct }}</span>%
        </span>
      </div>
      {%- if section.settings.price_note != blank -%}
        <p class="lp-price__note">{{ section.settings.price_note }}</p>
      {%- endif -%}

      {%- comment -%} 8. Stock {%- endcomment -%}
      {%- if section.settings.show_stock -%}
        <p class="lp-stock" data-lp-stock {% if stock_value == blank %}hidden{% endif %}>
          <span class="lp-stock__dot" aria-hidden="true"></span>
          <span>
            {%- capture stock_html -%}<strong data-lp-stock-count>{{ stock_value }}</strong>{%- endcapture -%}
            {{- section.settings.stock_text | replace: '[stock]', stock_html -}}
          </span>
        </p>
      {%- endif -%}

      {%- assign form_id = 'LpForm-' | append: section.id -%}
      {%- form 'product', product, id: form_id, class: 'lp-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-lp-variant-id>
        <input type="hidden" name="quantity" value="1">

        {%- comment -%} 9. Coloris {%- endcomment -%}
        {%- if color_option and color_option.values.size > 0 -%}
          <div class="lp-option" data-lp-color-picker>
            <p class="lp-option__label" id="LpColorLabel-{{ section.id }}">
              {{ section.settings.color_label | default: color_option.name }} :
              <strong data-lp-color-name>{{ color_option.selected_value }}</strong>
            </p>
            <div class="lp-swatches" role="radiogroup" aria-labelledby="LpColorLabel-{{ section.id }}">
              {%- for value in color_option.values -%}
                {%- liquid
                  assign value_handle = value.name | handleize
                  assign swatch_image = value.swatch.image
                  if swatch_image == blank
                    for media in product.media
                      if media_colors[forloop.index0] == value_handle
                        assign swatch_image = media.preview_image
                        break
                      endif
                    endfor
                  endif
                  if swatch_image == blank and value.variant.featured_media
                    assign swatch_image = value.variant.featured_media.preview_image
                  endif
                  assign swatch_color = value.swatch.color
                  if swatch_color == blank
                    case value_handle
                      when 'noir', 'black'
                        assign swatch_color = '#151515'
                      when 'blanc', 'white'
                        assign swatch_color = '#F4F4F4'
                      when 'gris', 'grey', 'gray'
                        assign swatch_color = '#9A9CA1'
                      when 'violet', 'purple'
                        assign swatch_color = '#7C5CD6'
                      when 'bleu', 'blue'
                        assign swatch_color = '#2F6FE4'
                      when 'rouge', 'red'
                        assign swatch_color = '#D93A3A'
                      when 'vert', 'green'
                        assign swatch_color = '#2E9F5B'
                      when 'rose', 'pink'
                        assign swatch_color = '#F2A0C0'
                    endcase
                  endif
                -%}
                <button
                  type="button"
                  class="lp-swatch"
                  role="radio"
                  data-lp-color
                  data-value="{{ value.name | escape }}"
                  data-handle="{{ value_handle }}"
                  aria-checked="{{ value.selected }}"
                  aria-label="{{ value.name | escape }}"
                  title="{{ value.name | escape }}"
                  {% if swatch_color != blank %}style="--lp-swatch: {{ swatch_color }};"{% endif %}
                >
                  {%- if swatch_image != blank -%}
                    {{ swatch_image | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', widths: '60, 120', sizes: '52px' }}
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} 10. Packs {%- endcomment -%}
        {%- if pack_option -%}
          <div class="lp-option" data-lp-pack-picker>
            {%- if section.settings.pack_label != blank -%}
              <p class="lp-option__label" id="LpPackLabel-{{ section.id }}">
                {{ section.settings.pack_label }} :
                <strong data-lp-pack-name>{{ pack_option.selected_value }}</strong>
              </p>
            {%- endif -%}
            <div class="lp-packs" role="radiogroup" aria-labelledby="LpPackLabel-{{ section.id }}">
              {%- for value in pack_option.values -%}
                {%- liquid
                  assign value_handle = value.name | handleize
                  assign pack_block = nil
                  for block in section.blocks
                    if block.type == 'pack'
                      assign block_handle = block.settings.option_value | handleize
                      if block_handle == value_handle
                        assign pack_block = block
                        break
                      endif
                    endif
                  endfor

                  assign pack_variants = product.variants | where: pack_key, value.name
                  if color_option
                    assign color_variants = pack_variants | where: color_key, color_option.selected_value
                    if color_variants.size > 0
                      assign pack_variants = color_variants
                    endif
                  endif
                  assign pack_variant = pack_variants | first

                  assign pack_image = pack_block.settings.image
                  if pack_image == blank
                    assign pack_image = pack_variant.featured_media.preview_image | default: product.featured_media.preview_image
                  endif
                  assign pack_title = pack_block.settings.title | default: value.name
                -%}
                <button
                  type="button"
                  class="lp-pack"
                  role="radio"
                  data-lp-pack
                  data-value="{{ value.name | escape }}"
                  aria-checked="{{ value.selected }}"
                  {% if pack_block %}{{ pack_block.shopify_attributes }}{% endif %}
                >
                  {%- if pack_block.settings.badge != blank -%}
                    <span class="lp-pack__badge{% if pack_block.settings.badge_style == 'accent' %} lp-pack__badge--accent{% endif %}">
                      {{- pack_block.settings.badge -}}
                    </span>
                  {%- endif -%}
                  <span class="lp-pack__radio" aria-hidden="true"></span>
                  <span class="lp-pack__media">
                    {%- if pack_image != blank -%}
                      {{ pack_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', widths: '80, 160', sizes: '56px' }}
                    {%- endif -%}
                  </span>
                  <span>
                    <span class="lp-pack__title">{{ pack_title }}</span>
                    {%- if pack_block.settings.description != blank -%}
                      <span class="lp-pack__desc">{{ pack_block.settings.description }}</span>
                    {%- endif -%}
                  </span>
                  <span class="lp-pack__prices">
                    <span class="lp-pack__price" data-lp-pack-price>{{ pack_variant.price | money }}</span>
                    <s class="lp-pack__compare" data-lp-pack-compare {% unless pack_variant.compare_at_price > pack_variant.price %}hidden{% endunless %}>
                      {{- pack_variant.compare_at_price | money -}}
                    </s>
                  </span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- elsif request.design_mode -%}
          {%- liquid
            assign pack_block_count = 0
            for block in section.blocks
              if block.type == 'pack'
                assign pack_block_count = pack_block_count | plus: 1
              endif
            endfor
          -%}
          {%- if pack_block_count > 0 -%}
            <p class="lp-editor-note">
              Sélecteur de pack masqué : ce produit n'a pas d'option nommée « {{ section.settings.pack_option_names }} ».
              Créez une option « Pack » avec les valeurs Console seule / Pack Protection / Pack Complet (voir LANDING-PAGE.md).
            </p>
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} 11. CTA {%- endcomment -%}
        <div class="lp-atc" data-lp-atc-wrapper>
          <button
            type="submit"
            name="add"
            class="lp-btn lp-btn--block"
            data-lp-atc
            data-atc-text="{{ section.settings.atc_label | escape }}"
            data-atc-separator="{{ section.settings.atc_separator | escape }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-lp-atc-label>
              {%- if current_variant.available -%}
                {{ section.settings.atc_label }}{{ section.settings.atc_separator }}<span data-lp-atc-price>{{ current_variant.price | money }}</span>
              {%- else -%}
                Épuisé
              {%- endif -%}
            </span>
          </button>
          <p class="lp-atc__error" data-lp-atc-error role="alert" hidden></p>
        </div>
      {%- endform -%}

      {%- comment -%} 12. Moyens de paiement {%- endcomment -%}
      {%- if section.settings.show_payments -%}
        <div class="lp-payments">
          {%- if section.settings.payment_image != blank -%}
            {{ section.settings.payment_image | image_url: width: 760 | image_tag: alt: 'Moyens de paiement acceptés', loading: 'lazy', widths: '380, 570, 760', sizes: '(min-width: 990px) 380px, 90vw' }}
          {%- else -%}
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag }}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} 13. Réassurance {%- endcomment -%}
      {%- liquid
        assign assurance_count = 0
        for block in section.blocks
          if block.type == 'assurance'
            assign assurance_count = assurance_count | plus: 1
          endif
        endfor
      -%}
      {%- if assurance_count > 0 -%}
        <ul class="lp-assurances" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'assurance' -%}
              <li class="lp-assurance" {{ block.shopify_attributes }}>
                <span class="lp-assurance__icon">{% render 'lp-icon', icon: block.settings.icon %}</span>
                <span>
                  <span class="lp-assurance__title">{{ block.settings.title }}</span>
                  <span class="lp-assurance__text">{{ block.settings.text }}</span>
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Barre CTA sticky (mobile uniquement) {%- endcomment -%}
  {%- if section.settings.show_sticky_atc -%}
    <div class="lp-sticky-atc" data-lp-sticky-atc aria-hidden="true">
      <div class="lp-sticky-atc__inner">
        <button
          type="button"
          class="lp-btn lp-btn--block"
          data-lp-sticky-atc-button
          data-atc-text="{{ section.settings.atc_label | escape }}"
          tabindex="-1"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span data-lp-sticky-label>
            {%- if current_variant.available -%}
              {{ section.settings.atc_label }} <span data-lp-atc-price>{{ current_variant.price | money }}</span>
            {%- else -%}
              Épuisé
            {%- endif -%}
          </span>
        </button>
      </div>
    </div>
  {%- endif -%}
</lp-product>

{% schema %}
{
  "name": "Landing — Produit (hero)",
  "tag": "section",
  "class": "lp-section-product",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (sans #)", "default": "produit" },
    { "type": "header", "content": "Variantes" },
    { "type": "text", "id": "color_option_names", "label": "Nom(s) de l'option coloris", "default": "Coloris, Couleur, Color", "info": "Séparés par des virgules. Les images sont associées au coloris via leur texte alternatif (ex. « Noir », « Noir - dos ») ou l'image de la variante." },
    { "type": "text", "id": "pack_option_names", "label": "Nom(s) de l'option pack", "default": "Pack, Offre, Bundle" },
    { "type": "text", "id": "color_label", "label": "Libellé du coloris", "default": "Coloris" },
    { "type": "text", "id": "pack_label", "label": "Libellé du pack", "info": "Laisser vide pour masquer le libellé au-dessus des packs." },
    { "type": "header", "content": "En-tête produit" },
    { "type": "text", "id": "badge_prefix", "label": "Badge (préfixe)", "default": "DÉSTOCKAGE", "info": "Affiché avec le % de remise calculé. Remplacé par le metafield custom.badge_text s'il est renseigné." },
    { "type": "text", "id": "subtitle", "label": "Sous-titre (repli)", "default": "Console portable double écran AMOLED · Snapdragon 8 Gen 2 · Android 13", "info": "Utilisé si le metafield custom.subtitle est vide." },
    { "type": "text", "id": "rating_text", "label": "Texte de la note", "default": "<strong>[note] sur 5</strong> · [avis] avis", "info": "[note] et [avis] proviennent des metafields du produit. Masqué si aucune note." },
    { "type": "text", "id": "reviews_anchor", "label": "Ancre de la section avis", "default": "avis" },
    { "type": "header", "content": "Compte à rebours" },
    { "type": "checkbox", "id": "show_countdown", "label": "Afficher", "default": true },
