{%- comment -%}
  Landing — FAQ « Questions fréquentes »
  Accordéon : une question se déploie / se replie (transition max-height), icône + → −.

  Questions : metafield JSON custom.faq_data, sinon blocs « Question » de la section.
  Format du metafield : [ { "question": "…", "answer": "…" } ]  (answer peut contenir du HTML simple)
{%- endcomment -%}
{%- liquid
  assign faqs = product.metafields.custom.faq_data.value
  assign use_metafield = false
  if faqs.size > 0
    assign use_metafield = true
  endif
  assign heading_id = 'LpFaqHeading-' | append: section.id
-%}
<section
  class="lp-section lp-faq{% if section.settings.background == 'alt' %} lp-section--alt{% endif %}"
  id="{{ section.settings.anchor | default: 'faq' }}"
  aria-labelledby="{{ heading_id }}"
>
  <div class="lp-container lp-faq__container">
    {% render 'lp-section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, id: heading_id %}

    <lp-accordion class="lp-accordion" {% if section.settings.single_open %}data-single{% endif %}>
      {%- if use_metafield -%}
        {%- for item in faqs -%}
          {%- assign item_id = section.id | append: '-' | append: forloop.index -%}
          <div class="lp-accordion__item">
            <h3 class="lp-accordion__heading">
              <button type="button" class="lp-accordion__trigger" aria-expanded="false" aria-controls="LpFaq-{{ item_id }}" id="LpFaqQ-{{ item_id }}">
                <span>{{ item.question }}</span>
                <span class="lp-accordion__icon" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="lp-accordion__panel" id="LpFaq-{{ item_id }}" role="region" aria-labelledby="LpFaqQ-{{ item_id }}" hidden>
              <div class="lp-accordion__content">{{ item.answer }}</div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign item_id = section.id | append: '-' | append: forloop.index -%}
          <div class="lp-accordion__item" {{ block.shopify_attributes }}>
            <h3 class="lp-accordion__heading">
              <button type="button" class="lp-accordion__trigger" aria-expanded="false" aria-controls="LpFaq-{{ item_id }}" id="LpFaqQ-{{ item_id }}">
                <span>{{ block.settings.question }}</span>
                <span class="lp-accordion__icon" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="lp-accordion__panel" id="LpFaq-{{ item_id }}" role="region" aria-labelledby="LpFaqQ-{{ item_id }}" hidden>
              <div class="lp-accordion__content">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </lp-accordion>
  </div>
</section>

{% schema %}
{
  "name": "Landing — FAQ",
  "tag": "div",
  "class": "lp-section-faq",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (sans #)", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Questions fréquentes" },
    { "type": "checkbox", "id": "single_open", "label": "Une seule question ouverte à la fois", "default": true },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Principal" },
        { "value": "alt", "label": "Alterné (gris clair)" }
      ],
      "default": "alt"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Quand vais-je recevoir ma commande ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Votre commande est expédiée sous 24h et livrée en 3 à 5 jours ouvrés.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing — FAQ",
      "blocks": [{ "type": "question" }]
    }
  ]
}
{% endschema %}
