    "faq_accordion": {
      "type": "faq-accordion",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Quand vais-je recevoir ma commande ?",
            "answer": "<p>Votre commande est préparée et expédiée sous 24h (jours ouvrés). Comptez ensuite 3 à 5 jours ouvrés pour la livraison, qui est offerte.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "La livraison est-elle vraiment gratuite ?",
            "answer": "<p>Oui. La livraison est offerte sur toutes les commandes, sans minimum d'achat.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Comment suivre mon colis ?",
            "answer": "<p>Dès l'expédition, vous recevez un numéro de suivi par SMS et par email pour suivre votre colis en temps réel.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Puis-je retourner la console si elle ne me convient pas ?",
            "answer": "<p>Oui. Vous disposez de 30 jours après réception pour nous retourner le produit gratuitement. Le remboursement est effectué dès réception du retour.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Le paiement est-il sécurisé ?",
            "answer": "<p>Oui. Les paiements sont chiffrés et traités par des prestataires certifiés (carte bancaire, Visa, Mastercard, PayPal, Apple Pay). Nous n'avons jamais accès à vos coordonnées bancaires.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Quelle est la différence entre les packs ?",
            "answer": "<p><strong>Console seule</strong> : la console. <strong>Pack Protection</strong> : console + housse + film protecteur écran + câble USB-C. <strong>Pack Complet</strong> : le Pack Protection + une carte SD 256 Go.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "À quels jeux puis-je jouer ?",
            "answer": "<p>La console fonctionne sous Android 13 : vous accédez au Google Play Store, aux applications Android compatibles et aux services de cloud gaming disponibles sur Android.</p>"
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "La console est-elle garantie ?",
            "answer": "<p>Oui. Comme tout produit vendu à un consommateur en France, elle bénéficie de la garantie légale de conformité de 2 ans. Notre service client vous accompagne en cas de souci.</p>"
          }
        },
        "question_9": {
          "type": "question",
          "settings": {
            "question": "Comment contacter le service client ?",
            "answer": "<p>Écrivez-nous depuis la page <a href=\"/pages/contact\">Contact</a> : nous vous répondons dans les meilleurs délais.</p>"
          }
        }
